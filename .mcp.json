{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/api",
      "headers": {
        "Authorization": "Bearer ${BOT_SLACK_TOKEN}",
        "X-Team-ID": "${TEAMID_SLACK}"
      }
    }
  }
}
